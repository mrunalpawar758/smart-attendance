# Database
DATABASE_URL=postgresql://smartattend:smartattend123@localhost:5432/smartattend_db

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production-minimum-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# App
APP_NAME=SmartAttend
APP_ENV=development
FRONTEND_URL=http://localhost:5173

# Face Recognition
FACE_RECOGNITION_THRESHOLD=0.55
FACE_RECOGNITION_MODEL=hog

# Attendance
DEFAULT_ATTENDANCE_THRESHOLD=75.0

# File Storage
UPLOAD_DIR=./uploads
FACE_PROFILES_DIR=./uploads/face_profiles

# Admin seed
SEED_ADMIN_EMAIL=admin@smartattend.edu
SEED_ADMIN_PASSWORD=Admin@123
